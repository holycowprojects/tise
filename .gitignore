# Local data — never commit. This is the whole point of the project.
# Leading slash matters: a bare `data/` also swallows research/tise_research/data/.
/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.csv
!service/tests/**/*.csv
!ml/**/fixtures/*.csv

# Local-only working notes — never published
CLAUDE.local.md
*.local.md
.claude/settings.local.json

# Verification screenshots and exports from real profiles. Kept local by decision: they
# show browsing domains, and DECISIONS.md cites them by name, so the claims stay traceable
# without publishing the evidence. The T5 spike screenshots ran on a throwaway profile and
# are published; those are listed explicitly below.
#
# The default is DENY. Everything under Screenshots/ is ignored and the published files
# are re-admitted one by one — the earlier rules named files to exclude, which meant every
# new screenshot was published unless someone remembered to add a pattern. A T11 export of
# 5,105 real domains sat untracked-but-publishable under that scheme.
/Screenshots/**
!/Screenshots/chrome screenshots/
!/Screenshots/chrome screenshots/ss_chrome*.png
!/Screenshots/chrome screenshots/ss_again*.png
!/Screenshots/chrome screenshots/ss_check*.png

# Belt and braces, path-independent: an export is a profile of a person wherever it lands.
**/tise-export-*.json
**/ss_tt*.png
**/ss_ta*.png

# Secrets
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Models and experiment artefacts
*.pkl
*.joblib
*.onnx
mlruns/
ml/experiments/**/output/

# Node / extension build
node_modules/
extension/dist/
*.zip

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Spike build output — regenerate with spike/permissions/build.py
spike/*/build/
