# Local data — never commit. This is the whole point of the project.
# Leading slash matters: a bare `data/` also swallows research/tise_research/data/.
/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.csv
!service/tests/**/*.csv
!ml/**/fixtures/*.csv

# Local-only working notes — never published
CLAUDE.local.md
*.local.md
.claude/settings.local.json

# T6 verification screenshots. Kept local by decision: they show real browsing domains,
# and DECISIONS.md cites them by name, so the claims stay traceable without publishing
# the evidence. The T5 spike screenshots ran on a throwaway profile and are published.
Screenshots/ss_tt*.png

# Secrets
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Models and experiment artefacts
*.pkl
*.joblib
*.onnx
mlruns/
ml/experiments/**/output/

# Node / extension build
node_modules/
extension/dist/
*.zip

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Spike build output — regenerate with spike/permissions/build.py
spike/*/build/
