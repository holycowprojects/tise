{
  "name": "tise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learns from your own browsing and predicts what you will do next, entirely on your device.",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
