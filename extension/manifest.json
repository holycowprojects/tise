{
  "manifest_version": 3,
  "name": "Tise",
  "version": "0.1.0",
  "description": "Learns from your own browsing and predicts what you'll do next, entirely on your device. Nothing is ever transmitted.",
  "minimum_chrome_version": "116",

  "permissions": ["webNavigation", "alarms"],
  "optional_permissions": ["history", "tabs", "idle"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Tise",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}
